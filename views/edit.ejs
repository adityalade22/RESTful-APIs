<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h2>Edit the Post!</h2>
    <h5>Username: @<%=post.username%></h5>
    <form method="post" action="/posts/<%=post.id%>?_method=PATCH">
        <textarea name="content" id="con" rows="10" cols="35"><%= post.content %></textarea>
        <button>Edit</button>
    </form>
</body>

</html>