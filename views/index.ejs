<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <h1>Quora Post</h1>
    <% for(post of posts) {%>
        <div class="post">
            <h3 class="user">@<%= post.username %>
            </h3>
            <h5 class="content">
                <%= post.content %>
            </h5>
            <button><a href="http://localhost:8080/posts/<%=post.id%>">See Details</a></button>
            &nbsp;&nbsp;&nbsp;
            <button><a href="http://localhost:8080/posts/<%=post.id%>/edit">Edit Post!</a></button>
            &nbsp;&nbsp;&nbsp;
            <form method="post" action="/posts/<%=post.id%>?_method=DELETE" id="del">
                <button>Delete post!</button>
            </form>
            <hr>
        </div>
        <% } %>
            <button><a href="http://localhost:8080/posts/new">Create New Post!</a></button>
</body>

</html>